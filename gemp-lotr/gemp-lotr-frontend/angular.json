{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "deckbuilder": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              {
                "input": "src/themes/classic/base.css",
                "bundleName": "theme-classic",
                "inject": false
              },
              {
                "input": "src/themes/classic/deckbuilder.css",
                "bundleName": "theme-classic-deckbuilder",
                "inject": false
              },
              {
                "input": "src/themes/classic/login.css",
                "bundleName": "theme-classic-login",
                "inject": false
              },
              {
                "input": "src/themes/classic/merchant.css",
                "bundleName": "theme-classic-merchant",
                "inject": false
              },
              {
                "input": "src/themes/classic/solo-draft.css",
                "bundleName": "theme-classic-solo-draft",
                "inject": false
              },
              {
                "input": "src/themes/classic/table-draft.css",
                "bundleName": "theme-classic-table-draft",
                "inject": false
              },
              {
                "input": "src/themes/classic/hall.css",
                "bundleName": "theme-classic-hall",
                "inject": false
              },
              {
                "input": "src/themes/modern/base.css",
                "bundleName": "theme-modern",
                "inject": false
              },
              {
                "input": "src/themes/modern/deckbuilder.css",
                "bundleName": "theme-modern-deckbuilder",
                "inject": false
              },
              {
                "input": "src/themes/modern/login.css",
                "bundleName": "theme-modern-login",
                "inject": false
              },
              {
                "input": "src/themes/modern/merchant.css",
                "bundleName": "theme-modern-merchant",
                "inject": false
              },
              {
                "input": "src/themes/modern/solo-draft.css",
                "bundleName": "theme-modern-solo-draft",
                "inject": false
              },
              {
                "input": "src/themes/modern/table-draft.css",
                "bundleName": "theme-modern-table-draft",
                "inject": false
              },
              {
                "input": "src/themes/modern/hall.css",
                "bundleName": "theme-modern-hall",
                "inject": false
              }
            ],
            "outputPath": {
              "base": "../gemp-lotr-async/src/main/web/ng",
              "browser": ""
            },
            "baseHref": "/gemp-lotr/ng/"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "deckbuilder:build:production"
            },
            "development": {
              "buildTarget": "deckbuilder:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.mjs"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
